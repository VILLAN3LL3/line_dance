{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "pr",
    "platformAutomerge": false
  },
  "packageRules": [
    {
      "groupName": "Playwright npm and Docker",
      "groupSlug": "playwright-npm-docker",
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "minimumGroupSize": 2,
      "separateMajorMinor": false
    },
    {
      "matchPackageNames": ["@playwright/test"],
      "matchManagers": ["npm"],
      "rangeStrategy": "pin"
    },
    {
      "groupName": "emnapi",
      "matchPackageNames": ["@emnapi/{/,}**"]
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    }
  ]
}
