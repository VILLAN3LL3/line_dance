{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "app.ts",
    "eslint.config.ts",
    "features/**/*.ts",
    "migrations/**/*.ts",
    "routes/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "utils/**/*.ts",
    "vitest.config.ts"
  ]
}
