{
  "name": "line-dance-api",
  "version": "1.0.0",
  "description": "Line Dance Choreography Search API",
  "main": "scripts/server.ts",
  "type": "module",
  "scripts": {
    "start": "node scripts/server.ts",
    "dev": "node --watch scripts/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "migrate": "node migrations/run-migrations.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "express-rate-limit": "^8.7.3",
    "pdfkit": "^0.20.0",
    "qrcode": "^1.5.4",
    "sqlite3": "^6.0.0",
    "svg-to-pdfkit": "^0.1.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@emnapi/core": "^1.9.1",
    "@emnapi/runtime": "^1.9.1",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.0",
    "@types/svg-to-pdfkit": "^0.1.5",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "openapi-types": "^12.1.3",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.28.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
