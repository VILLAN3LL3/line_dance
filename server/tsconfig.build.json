{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowJs": false,
    "rewriteRelativeImportExtensions": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": [
    "app.ts",
    "contracts/**/*.ts",
    "features/**/*.ts",
    "migrations/**/*.ts",
    "routes/**/*.ts",
    "scripts/**/*.ts",
    "utils/**/*.ts"
  ],
  "exclude": ["tests", "dist", "node_modules"]
}
