#!/usr/bin/env sh

set -e

cd "$(git rev-parse --show-toplevel)"

if ! command -v npm >/dev/null 2>&1; then
	NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
	if [ -s "$NVM_DIR/nvm.sh" ]; then
		. "$NVM_DIR/nvm.sh"
	fi
fi

PM2_BINARY="${PM2_BINARY:-$(command -v pm2 || true)}"
if [ -z "$PM2_BINARY" ]; then
	for candidate in "${NVM_DIR:-$HOME/.nvm}"/versions/node/*/bin/pm2; do
		if [ -x "$candidate" ]; then
			PM2_BINARY="$candidate"
			break
		fi
	done
fi

if [ -z "$PM2_BINARY" ] || [ ! -x "$PM2_BINARY" ]; then
	echo "Deploy failed: PM2 not found. Install PM2 or set PM2_BINARY to its absolute path." >&2
	exit 1
fi

if "$PM2_BINARY" describe line-dance >/dev/null 2>&1; then
	PM2_PROCESSES=$("$PM2_BINARY" jlist)
	printf '%s' "$PM2_PROCESSES" | node -e '
		const path = require("node:path");
		let input = "";
		process.stdin.setEncoding("utf8");
		process.stdin.on("data", chunk => input += chunk);
		process.stdin.on("end", () => {
			const processes = JSON.parse(input).filter(item => item.name === "line-dance");
			const expected = path.resolve("server/dist/scripts/server.js");
			if (processes.length !== 1 || processes[0].pm2_env?.pm_exec_path !== expected) {
				console.error("Deploy failed: the existing PM2 process uses a different entry point. Recreate it using ecosystem.config.js before deploying.");
				process.exitCode = 1;
			}
		});
	'
	REGISTERED=true
else
	REGISTERED=false
fi

echo "Building server..."
npm --prefix server run build

echo "Building client..."
npm --prefix client run build

echo "Restarting line-dance server..."
if [ "$REGISTERED" = true ]; then
	"$PM2_BINARY" restart line-dance --update-env
else
	"$PM2_BINARY" start ecosystem.config.js
fi

echo "Deploy complete: http://localhost:3001"
